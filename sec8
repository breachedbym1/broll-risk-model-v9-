    "def ruin_finite(B, mu, sigma, T):\n",
    "    s = sigma * np.sqrt(T)\n",
    "    return norm.cdf((-B - mu * T) / s) + np.exp(-2 * mu * B / sigma**2) * norm.cdf((-B + mu * T) / s)\n",
    "\n",
    "def ruin_infinite(B, mu, sigma):\n",
    "    return np.exp(-2 * mu * B / sigma**2)\n",
    "\n",
    "buyins = np.array([5, 10, 15, 20, 25, 30, 40])\n",
    "rows = []\n",
    "for b in buyins:\n",
    "    sim = simulate_paths(b * BUY_IN, mu, sigma, N_BLOCKS, N_PATHS, np.random.default_rng(SEED + int(b)))\n",
    "    p = (sim[:, -1] <= 0).mean()\n",
    "    rows.append({\"Bankroll (buy-ins)\": b,\n",
    "                 \"Simulated\": p,\n",
    "                 \"95% margin\": 1.96 * np.sqrt(p * (1 - p) / N_PATHS),\n",
    "                 \"Theory (10,000 hands)\": ruin_finite(b * BUY_IN, mu, sigma, N_BLOCKS),\n",
    "                 \"Theory (no time limit)\": ruin_infinite(b * BUY_IN, mu, sigma)})\n",
    "check = pd.DataFrame(rows).set_index(\"Bankroll (buy-ins)\")\n",
    "check.style.format(\"{:.1%}\")"
   ]
