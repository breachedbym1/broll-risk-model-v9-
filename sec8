    "def simulate_paths(bankroll, mu, sigma, n_blocks, n_paths, rng):\n",
    "    \"\"\"Return an (n_paths, n_blocks + 1) array of bankroll paths. Ruin at $0 is absorbing.\"\"\"\n",
    "    results = rng.normal(mu, sigma, size=(n_paths, n_blocks))\n",
    "    paths = bankroll + np.cumsum(results, axis=1)\n",
    "    ever_broke = np.minimum.accumulate(paths, axis=1) <= 0   # True from the first time a path hits 0\n",
    "    paths[ever_broke] = 0.0\n",
    "    start = np.full((n_paths, 1), float(bankroll))\n",
    "    return np.hstack([start, paths])\n",
    "\n",
    "rng = np.random.default_rng(SEED)\n",
    "paths = simulate_paths(BANKROLL, mu, sigma, N_BLOCKS, N_PATHS, rng)\n",
    "paths.shape"
   ]
  },
